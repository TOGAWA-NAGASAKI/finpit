# ============================================================
# finpit 配置模板
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，不会提交。
# ============================================================

# --- LLM 接入（可选；不配置也能跑词典基线路径）---
# 任何 OpenAI 兼容端点都可以，例如：
#   DeepSeek 官方   https://api.deepseek.com/v1
#   OpenAI          https://api.openai.com/v1
#   OpenCode Go     https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MODEL_FAST=deepseek-chat

# --- OpenCode Go 通道专用（其他厂商留空）---
# 该通道要求额外两个请求头：x-opencode-org-id 与稳定的 x-opencode-session。
# 详见 src/finpit/llm/client.py 的模块文档。
OPENCODE_ORG_ID=

# --- 缓存目录（LLM 结果会落盘，重跑评测零成本）---
# FINPIT_CACHE_DIR=~/.cache/finpit
